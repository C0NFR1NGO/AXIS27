# Web3Forms — contact form + NotifyMe email captures.
# Create a free access key at https://web3forms.com (one key serves both forms).
# Without this key the contact form shows a "not configured" notice and
# NotifyMe falls back to a localStorage-only ledger.
VITE_WEB3FORMS_KEY=your-web3forms-access-key

# Public site URL used for og:url / sitemap / robots defaults.
# Update if the deployment domain changes.
# VITE_SITE_URL=https://axis27alt.vercel.app
