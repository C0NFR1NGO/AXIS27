      @font-face {
        font-family: 'Ethnocentric';
        src: url('assets/fonts/Ethnocentric.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: block;
      }
      @font-face {
        font-family: 'Audiowide';
        src: url('assets/fonts/Audiowide-latin.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: block;
      }
      @font-face {
        font-family: 'Inter Tight';
        src: url('assets/fonts/InterTight-400-latin.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: block;
      }
      @font-face {
        font-family: 'Inter Tight';
        src: url('assets/fonts/InterTight-500-latin.woff2') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: block;
      }
      @font-face {
        font-family: 'Inter Tight';
        src: url('assets/fonts/InterTight-600-latin.woff2') format('woff2');
        font-weight: 600;
        font-style: normal;
        font-display: block;
      }
      @font-face {
        font-family: 'Inter Tight';
        src: url('assets/fonts/InterTight-700-latin.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: block;
      }
      @font-face {
        font-family: 'Martian Mono';
        src: url('assets/fonts/MartianMono-400-latin.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: block;
      }

      html,
      body {
        margin: 0;
        background: var(--ground);
      }

      #root {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
      }

      /* ============ persistent world ============ */
      #world {
        position: absolute;
        inset: 0;
      }
      #sky {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, #050302 0%, #070503 38%, #0d0906 62%, #161008 74%, #1b130d 86%, #241810 100%);
      }
      /* the dawn — the whole minute warms, then ignites */
      #dawn {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg,
          rgba(30, 18, 8, 0) 0%,
          rgba(30, 18, 8, 0.35) 40%,
          rgba(138, 64, 22, 0.62) 60%,
          rgba(190, 88, 34, 0.9) 74%,
          rgba(255, 122, 26, 0.95) 88%,
          rgba(255, 150, 70, 1) 100%);
        opacity: 0;
      }
      #glow-l {
        position: absolute;
        width: 760px;
        height: 460px;
        left: -150px;
        top: 33%;
        background: radial-gradient(closest-side, rgba(255, 138, 47, 0.34), transparent 70%);
      }
      #glow-r {
        position: absolute;
        width: 900px;
        height: 500px;
        right: -210px;
        top: 29%;
        background: radial-gradient(closest-side, rgba(255, 122, 26, 0.26), transparent 70%);
      }
      #stars {
        position: absolute;
        inset: 0;
        overflow: hidden;
      }
      #meteor {
        position: absolute;
        top: 22%;
        left: -300px;
        width: 300px;
        height: 2px;
        background: linear-gradient(90deg, rgba(255, 170, 90, 0), rgba(255, 190, 120, 0.85) 68%, #fff2dd 100%);
        border-radius: 2px;
        filter: drop-shadow(0 0 6px rgba(255, 170, 90, 0.8));
        opacity: 0;
      }
      #moon-a {
        position: absolute;
        width: 60px;
        height: 60px;
        top: 9.5%;
        left: 68%;
        border-radius: 50%;
        background: radial-gradient(circle at 38% 36%, #fff4dc, #d9c9a8 58%, rgba(217, 201, 168, 0) 72%);
      }
      #moon-b {
        position: absolute;
        width: 96px;
        height: 96px;
        top: 26.5%;
        left: 93%;
        border-radius: 50%;
        background: radial-gradient(circle at 40% 34%, #ffdec0, #e0984f 55%, rgba(224, 152, 79, 0) 72%);
      }
      #seam {
        position: absolute;
        left: 0;
        right: 0;
        top: var(--seam-y);
        height: 2px;
        background: rgba(255, 122, 26, 0.95);
        box-shadow: 0 0 14px rgba(255, 122, 26, 0.5), 0 0 42px rgba(255, 122, 26, 0.24);
      }
      #seam-glow {
        position: absolute;
        left: 0;
        right: 0;
        top: var(--seam-y);
        height: 150px;
        transform: translateY(-50%);
        background: radial-gradient(closest-side, rgba(255, 150, 60, 0.42), rgba(255, 150, 60, 0.1) 46%, transparent 70%);
      }
      #seam-flare {
        position: absolute;
        left: 0;
        right: 0;
        top: var(--seam-y);
        height: 110px;
        transform: translateY(-50%);
        background: radial-gradient(closest-side, rgba(255, 150, 60, 0.55), rgba(255, 150, 60, 0.14) 45%, transparent 70%);
      }
      #dunes {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 70%;
        overflow: hidden;
      }

      /* ============ scene scaffolding ============ */
      .clip {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        overflow: hidden;
      }
      .scene-inner {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        text-align: center;
        padding: 80px 140px;
      }

      /* ============ typography helpers ============ */
      .warm-word {
        color: var(--ember);
      }
      .cold-word {
        color: var(--blue);
      }
      .eyebrow {
        font-family: 'Martian Mono', monospace;
        font-weight: 400;
        font-size: 26px;
        letter-spacing: 0.55em;
        text-indent: 0.55em;
        text-transform: uppercase;
        color: var(--text-dim);
        margin: 0;
      }
      .warm-hairline {
        width: 150px;
        height: 2px;
        background: var(--blue);
        box-shadow: 0 0 10px rgba(0, 168, 232, 0.35);
        margin: 0;
      }

      /* ============ scene 1 — hook ============ */
      #hook-1,
      #hook-2 {
        font-family: 'Inter Tight', sans-serif;
        font-weight: 400;
        font-size: 66px;
        line-height: 1.25;
        letter-spacing: 0.02em;
        color: var(--bone);
        max-width: 1500px;
        margin: 0;
        text-shadow: 0 1px 30px rgba(10, 6, 3, 0.95);
      }
      #hook-2 {
        margin-top: 26px;
        font-weight: 500;
      }

      /* ============ scene 2 — the wordmark ============ */
      .title-scrim {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 1560px;
        height: 560px;
        transform: translate(-50%, -50%);
        background: radial-gradient(closest-side, rgba(4, 3, 2, 0.78), rgba(4, 3, 2, 0.35) 55%, rgba(4, 3, 2, 0) 78%);
        pointer-events: none;
      }
      .glyph {
        display: inline-block;
      }
      #wordmark,
      #wordmark-final {
        font-family: 'Ethnocentric', sans-serif;
        font-weight: 400;
        line-height: 1.02;
        letter-spacing: 0.04em;
        text-indent: 0.04em;
        text-transform: uppercase;
        color: var(--bone);
        margin: 0;
      }
      #wordmark {
        font-size: 190px;
      }
      #wordmark-final {
        font-size: 252px;
        margin-top: 64px;
      }
      #wm-glow,
      #halo {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        background: radial-gradient(closest-side, rgba(255, 150, 60, 0.3), rgba(255, 150, 60, 0.1) 52%, transparent 74%);
        pointer-events: none;
      }
      #wm-glow {
        width: 1450px;
        height: 560px;
      }
      #halo {
        width: 1240px;
        height: 620px;
        top: 46%;
      }
      #theme,
      #theme-final {
        font-family: 'Audiowide', sans-serif;
        font-weight: 400;
        font-size: 64px;
        line-height: 1.2;
        letter-spacing: 0.34em;
        text-indent: 0.34em;
        text-transform: uppercase;
        color: var(--ember);
        margin: 46px 0 0 0;
        text-shadow: 0 0 30px rgba(255, 122, 26, 0.35), 0 1px 22px rgba(10, 6, 3, 0.9);
      }
      #claim {
        font-family: 'Inter Tight', sans-serif;
        font-weight: 500;
        font-size: 38px;
        line-height: 1.35;
        letter-spacing: 0.04em;
        color: var(--text-2);
        margin: 34px 0 0 0;
        max-width: 1500px;
        text-shadow: 0 1px 24px rgba(10, 6, 3, 0.9);
      }

      /* ============ scene 3 — the counters ============ */
      #panel {
        background: rgba(18, 16, 12, 0.86);
        border: 1px solid var(--line-quiet);
        border-top: 2px solid rgba(0, 168, 232, 0.42);
        border-radius: 4px;
        box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.4), 0 30px 90px rgba(0, 0, 0, 0.55);
        padding: 70px 96px 60px 96px;
        display: flex;
        gap: 96px;
        align-items: flex-end;
      }
      .stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 26px;
        min-width: 300px;
      }
      .statval-row {
        display: flex;
        align-items: baseline;
        justify-content: center;
      }
      .statval {
        font-family: 'Audiowide', sans-serif;
        font-weight: 400;
        font-size: 112px;
        line-height: 1;
        color: var(--blue);
        text-shadow: 0 0 34px rgba(0, 168, 232, 0.38);
      }
      .plussign {
        font-family: 'Audiowide', sans-serif;
        font-weight: 400;
        font-size: 62px;
        line-height: 1;
        color: var(--blue);
        margin-left: 8px;
      }
      .statlabel {
        font-family: 'Martian Mono', monospace;
        font-weight: 400;
        font-size: 26px;
        letter-spacing: 0.3em;
        text-indent: 0.3em;
        text-transform: uppercase;
        color: var(--text-dim);
        border-top: 1px solid var(--line-quiet);
        padding-top: 18px;
      }
      #panel-note {
        font-family: 'Martian Mono', monospace;
        font-weight: 400;
        font-size: 26px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text-dim);
        margin: 56px 0 0 0;
        text-shadow: 0 1px 20px rgba(10, 6, 3, 0.9);
      }

      /* ============ scene 4 — the town ============ */
      #domain-line {
        font-family: 'Martian Mono', monospace;
        font-weight: 400;
        font-size: 22px;
        line-height: 1.6;
        letter-spacing: 0.18em;
        text-indent: 0.3em;
        text-transform: uppercase;
        color: var(--text-dim);
        margin: 0 0 54px 0;
        text-shadow: 0 1px 20px rgba(10, 6, 3, 0.9);
      }
      #cards {
        display: flex;
        flex-direction: column;
        gap: 40px;
        align-items: center;
      }
      .card-row {
        display: flex;
        flex-direction: row;
        gap: 42px;
        align-items: stretch;
      }
      .ecard {
        width: 470px;
        background: rgba(18, 16, 12, 0.9);
        border: 1px solid var(--line-quiet);
        border-radius: 4px;
        padding: 44px 46px 40px 46px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 24px;
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.5);
        position: relative;
      }
      .ecard::after {
        content: '';
        position: absolute;
        left: -1px;
        right: -1px;
        bottom: -1px;
        height: 2px;
        background: var(--ember);
        box-shadow: 0 0 12px rgba(255, 122, 26, 0.5);
      }
      .ecard-top {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .ecard-index {
        font-family: 'Martian Mono', monospace;
        font-weight: 400;
        font-size: 24px;
        letter-spacing: 0.14em;
        color: var(--blue);
      }
      .ecard-name {
        font-family: 'Audiowide', sans-serif;
        font-weight: 400;
        font-size: 52px;
        line-height: 1.05;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--bone);
        margin: 0;
      }
      .ecard-tag {
        font-family: 'Inter Tight', sans-serif;
        font-weight: 600;
        font-size: 30px;
        line-height: 1.35;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--sand);
        margin: 0;
      }

      /* ============ scene 5 — the thesis ============ */
      #thesis-1,
      #thesis-2,
      #thesis-3,
      #thesis-4 {
        font-family: 'Inter Tight', sans-serif;
        font-weight: 600;
        font-size: 74px;
        line-height: 1.3;
        letter-spacing: 0.02em;
        color: var(--bone);
        max-width: 1500px;
        margin: 0;
        text-shadow: 0 1px 26px rgba(10, 6, 3, 0.95);
      }
      #thesis-4 {
        margin: 0;
      }
      .warm-hairline {
        margin-top: 44px;
      }
      #thesis-3 {
        margin: 44px 0 0 0;
      }
      #thesis-2 {
        margin: 32px 0 0 0;
      }
      #thesis-1 {
        margin: 0;
      }

      /* ============ scene 6 — the finale ============ */
      #address {
        font-family: 'Martian Mono', monospace;
        font-weight: 400;
        font-size: 30px;
        line-height: 1.4;
        letter-spacing: 0.18em;
        text-indent: 0.18em;
        text-transform: uppercase;
        color: var(--text-dim);
        margin: 46px 0 0 0;
        text-shadow: 0 1px 22px rgba(10, 6, 3, 0.95);
      }
      #fade-black {
        position: absolute;
        inset: 0;
        background: #030201;
        opacity: 0;
      }
    </style>
