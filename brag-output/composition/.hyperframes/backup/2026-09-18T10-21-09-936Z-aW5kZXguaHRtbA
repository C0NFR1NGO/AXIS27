      :root {
        --ground: #070503;
        --surface: #0c0906;
        --panel: #12100c;
        --bone: #f2e4cc;
        --sand: #e8c89a;
        --ember: #ff7a1a;
        --blue: #00a8e8;
        --white: #f2f7fa;
        --text-2: #ded2bd;
